#!/sbin/sh
# Bootloop Protector - installer entry
#   From a root manager: normal module install.
#   From a custom recovery (TWRP): disables all modules and general scripts,
#   so a phone that is stuck in a boot loop can start again.

umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() {
  if [ "$BOOTMODE" = true ]; then
    echo "$1"
  else
    echo "ui_print $1" >> "/proc/self/fd/$OUTFD"
    echo "ui_print" >> "/proc/self/fd/$OUTFD"
  fi
}

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

# ---------- recovery rescue ----------

ID=bootloop-protector
DATA=/data/adb/bootloop-protector
LIST=$DATA/state/rescue.list

clean_list() {
  [ -f "$1" ] || return 0
  sed -e 's/\r$//' -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$'
}

disable_in() {
  for m in "$1"/*/; do
    m="${m%/}"
    [ -d "$m" ] || continue
    id="${m##*/}"
    case "$id" in "$ID"|lost+found) continue ;; esac
    if clean_list "$DATA/allowed-modules.txt" | grep -Fxq "$id"; then
      ui_print "- Keeping $id (allowed)"
      continue
    fi
    [ -f "$m/disable" ] && continue
    touch "$m/disable" && chmod 644 "$m/disable"
    echo "module:$id" >> "$LIST"
    ui_print "- Disabled $id"
  done
}

recovery_rescue() {
  ui_print " "
  ui_print "  Bootloop Protector - recovery rescue"
  ui_print " "
  mount /data 2>/dev/null
  if [ ! -d /data/adb ]; then
    ui_print "! /data/adb is not reachable. Is /data decrypted?"
    exit 1
  fi
  mkdir -p "$DATA/state"

  for d in /data/adb/post-fs-data.d /data/adb/post-mount.d /data/adb/service.d /data/adb/boot-completed.d; do
    [ -d "$d" ] || continue
    for s in "$d"/* "$d"/.[!.]*; do
      [ -f "$s" ] && [ -x "$s" ] || continue
      if clean_list "$DATA/allowed-scripts.txt" | grep -Fxq "${s##*/}"; then
        ui_print "- Keeping ${s##*/} (allowed)"
        continue
      fi
      chmod 644 "$s"
      echo "script:$s" >> "$LIST"
      ui_print "- Disabled script ${s##*/}"
    done
  done

  [ -d /data/adb/modules ] && disable_in /data/adb/modules

  # Older KernelSU / APatch keep modules in an image
  for img in /data/adb/ksu/modules.img /data/adb/ap/modules.img; do
    [ -f "$img" ] || continue
    mnt=/data/local/tmp/bp-modules
    mkdir -p "$mnt"
    if mount -t ext4 -o loop "$img" "$mnt" 2>/dev/null || mount "$img" "$mnt" 2>/dev/null; then
      ui_print "- Found $img"
      disable_in "$mnt"
      umount "$mnt"
    else
      ui_print "! Could not mount $img"
    fi
    rmdir "$mnt" 2>/dev/null
  done

  printf 'time=%s\nlevel=2\nreason=recovery flash\ncount=%s\n' "$(date +%s)" \
    "$(wc -l < "$LIST" 2>/dev/null || echo 0)" > "$DATA/state/last-rescue"
  echo "$(date '+%Y-%m-%d %H:%M:%S') [recovery] RESCUE from recovery flash" >> "$DATA/bp.log"
  ui_print " "
  ui_print "- Done. Reboot the phone."
  ui_print "- Use the Action button or WebUI to restore them later."
  exit 0
}

# ---------- main ----------

if [ "$BOOTMODE" != true ]; then
  recovery_rescue
fi

mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk
install_module
exit 0
